# PostgreSQL (Neon) connection string shared with the Nutripak admin dashboard.
# Used to save real orders and contact enquiries coming from the storefront.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"

# Outbound SMTP for form submissions (order + query emails).
# Hostinger mailbox: auth user is saad@gosoftlabs.com.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""

# Optional overrides. MAIL_FROM defaults to SMTP_USER.
# MAIL_FROM="saad@gosoftlabs.com"
# MAIL_TO="nutripak.np@gmail.com,muhammadsaadprofessional@gmail.com"
